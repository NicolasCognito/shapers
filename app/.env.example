# LLM for the chat agent (DeepSeek is OpenAI-compatible)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Google Calendar (read-only, public calendar + API key)
GOOGLE_CALENDAR_API_KEY=
GOOGLE_CALENDAR_ID=

# Voice input for Jarvis. Provider is pluggable: groq (default), openai,
# or openai-compatible (self-hosted Whisper: set VOICE_BASE_URL + VOICE_MODEL).
# Without a key the browser's own speech recognition is used (Chrome/Edge).
GROQ_API_KEY=
VOICE_PROVIDER=groq
# VOICE_MODEL=whisper-large-v3-turbo
# VOICE_BASE_URL=
# VOICE_API_KEY=

# Tree demo controls (skip a day, add water, reset). Leave unset in production.
# TREE_DEMO=1

# Slack extras (announcements 3 days / reminders 1 day before, admin activity signal)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL=all-shapershackathon
PUBLIC_URL=
# Manual linking of members to Slack users (sandbox emails aren't real). Off in production.
# SLACK_DEMO_MAPPING=1
